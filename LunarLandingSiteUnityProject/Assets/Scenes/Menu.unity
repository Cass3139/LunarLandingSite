  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Luminosity score:\n\nThis luminosity is enough to power   1m x 1m solar
    panels. Space missions rely on this energy to power their space devices!\n\nTopology
    score:\n\nFor a safe landing on the moon, the landing spot must be relatively
    flat, outside of a crater, as well as far away from any mountains that could
    obstruct the view of the spacecraft.\n\nCommunication :\n\nIt\u2019s very important
    to have a direct line of communication with the earth, so the space team can
    send the information they\u2019ve collected to the earth team!\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9b03321da09a0bb5abb01863d32ca427, type: 2}
